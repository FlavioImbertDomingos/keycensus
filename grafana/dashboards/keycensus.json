          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(keycensus_assets)",
          "legendFormat": "__auto",
          "refId": "R2",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"

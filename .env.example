# Copy to .env. Docker Compose reads it automatically.

# ---------------- host ports ----------------
# Only the HOST side of each mapping changes here; container ports and the URLs
# services use to reach each other (http://kms:5000, http://vault:8200) do not.
# Change any line that collides with something already running on your machine.

KEYCENSUS_PORT=9742       # report.html / cbom.json / inventory.json / metrics
VAULT_PORT=8200           # Vault dev server UI + API
KMS_PORT=5050             # moto (AWS KMS mock). On macOS host port 5000 belongs to the
                          # AirPlay Receiver (System Settings > General > AirDrop & Handoff),
                          # which is why the default here is 5050 and not 5000.
VOLTAGE_PORT=8800         # mock Voltage SecureData export
VOLTAGE_TLS_PORT=8443     # the TLS endpoint the demo scans
PROMETHEUS_PORT=9090      # --profile monitoring
GRAFANA_PORT=3000         # --profile monitoring

# ---------------- demo ----------------
# How often the demo rescans
KEYCENSUS_INTERVAL=2m

# Demo secrets (the mocks accept exactly these)
HSM_PIN=1234
VAULT_TOKEN=root
VOLTAGE_PASSWORD=changeme

# For real sources, add the env vars your config references, e.g.
# LUNA_PIN_PAYMENTS=...
# VAULT_TOKEN=hvs....
# AWS_PROFILE=prod
# CTM_PASSWORD=...          # CipherTrust Manager
# KS5_TOKEN=...             # KeySafe 5 bearer token
# AZURE_TOKEN=...           # only with auth: token (otherwise DefaultAzureCredential / workload identity)
# GCP_TOKEN=...             # only with auth: token (otherwise Application Default Credentials)
# DTRACK_API_KEY=...        # keycensus upload dtrack

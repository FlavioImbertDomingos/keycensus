# Copy to .env. Docker Compose reads it automatically.

# How often the demo rescans
KEYCENSUS_INTERVAL=2m

# Demo secrets (the mocks accept exactly these)
HSM_PIN=1234
VAULT_TOKEN=root
VOLTAGE_PASSWORD=changeme

# For real sources, add the env vars your config references, e.g.
# LUNA_PIN_PAYMENTS=...
# VAULT_TOKEN=hvs....
# AWS_PROFILE=prod
# CTM_PASSWORD=...          # CipherTrust Manager
# KS5_TOKEN=...             # KeySafe 5 bearer token
# AZURE_TOKEN=...           # only with auth: token (otherwise DefaultAzureCredential / workload identity)
# GCP_TOKEN=...             # only with auth: token (otherwise Application Default Credentials)
# DTRACK_API_KEY=...        # keycensus upload dtrack
